// =============================================================================
// SooulOne — data layer (build prompt Section 6)
//
// This is the Section 6 schema with the corrections needed to make it a valid,
// migratable Prisma schema. Every deviation from the document is marked
// [FIX] or [ADDED] with the reason, so the brief and the code can be diffed.
//
// [FIX] The document writes the datasource block inline with semicolons
//       (`datasource db { provider = "postgresql"; url = env("DATABASE_URL") }`).
//       Prisma's grammar has no statement separator — this must be multi-line.
// [FIX] Several relations in the document are declared on only one side.
//       Prisma requires both. Back-relations added on Brand, Category and
//       ProductBatch; each is marked below.
// [FIX] Prisma ORM 7 removed `datasource.url` from schema.prisma entirely —
//       it now belongs in prisma.config.ts, alongside the driver adapter that
//       v7 also requires for every relational database. See prisma.config.ts
//       and src/lib/db.ts, and the README's "found while building" section
//       for why this isn't simply a preference.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// What each role may do lives in src/lib/permissions.ts. STAFF predates the
/// finer roles and is kept as the least-privileged default: view-only.
enum AdminRole {
  OWNER
  STAFF
  MANAGER
  FULFILMENT
  CONTENT
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  FAILED
  /// Return to origin: the parcel came back undelivered (refused at the door,
  /// unreachable, bad address). The main cost of cash on delivery.
  RTO
  /// Delivered, then sent back by the customer.
  RETURNED
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

/// Drives which label fields the admin form makes mandatory and which
/// copy-guardrails apply. See build prompt Section 2.3 — packaged food and
/// health supplements sit under different FSSAI rule sets, and collapsing them
/// into one "product" shape is how a mandatory allergen field ships blank.
enum RegulatoryType {
  PACKAGED_FOOD
  HEALTH_SUPPLEMENT
  BEVERAGE
}

model Brand {
  id            String     @id @default(cuid())
  /// "the-true-store" | "woman-axis" | "kids-vault" | "man-rituals" | future lines
  slug          String     @unique
  name          String
  tagline       String?
  /// Brand accent colour. Seeded as a neutral placeholder until the brand kit exists —
  /// the seed script does not invent brand colours (Section 14).
  colorToken    String
  description   String?
  /// True for The True Store — the only brand operating physical superstores.
  isRetailBrand Boolean    @default(false)
  isActive      Boolean    @default(true)
  categories    Category[]
  products      Product[]
  bundles       Bundle[] // [FIX] back-relation for Bundle.brand
  quizResponses QuizResponse[] // [FIX] back-relation for QuizResponse.brand
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Category {
  id            String         @id @default(cuid())
  brandId       String
  brand         Brand          @relation(fields: [brandId], references: [id])
  slug          String
  /// e.g. "Hair Fall" (Man Rituals), "Healthy Namkeen" (True Store — proposed, confirm)
  name          String
  description   String?
  imageUrl      String?
  sortOrder     Int            @default(0)
  isActive      Boolean        @default(true)
  products      Product[]
  quizRecommendations QuizResponse[] // [FIX] back-relation for QuizResponse.recommendedCategory
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([brandId, slug])
}

model Product {
  id               String         @id @default(cuid())
  sku              String         @unique
  name             String
  slug             String         @unique
  brandId          String
  brand            Brand          @relation(fields: [brandId], references: [id])
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id])
  regulatoryType   RegulatoryType
  shortDescription String
  /// Markdown. For HEALTH_SUPPLEMENT this must stay in structure/function language
  /// ("supports", "helps maintain") and never therapeutic language ("treats",
  /// "cures", "prevents"). Enforced at the admin boundary — see src/lib/compliance/claims.ts.
  description      String
  basePrice        Decimal        @db.Decimal(10, 2)
  compareAtPrice   Decimal?       @db.Decimal(10, 2)
  /// [ADDED] Percentage-off promotion. `basePrice` stays the undiscounted price;
  /// the shopper pays basePrice less `discountPercent` while `discountActive`.
  discountActive   Boolean        @default(false)
  discountPercent  Decimal?       @db.Decimal(5, 2)
  hsnCode          String?
  taxRatePercent   Decimal        @default(18) @db.Decimal(4, 2)
  /// ONLINE stock only. Retail superstore stock is deliberately out of scope
  /// (Decision #3) — this number never represents in-store availability.
  stockQuantity     Int           @default(0)
  lowStockThreshold Int           @default(10)
  weightGrams       Int?
  isActive          Boolean       @default(true)
  isFeatured        Boolean       @default(false)
  isOfferZone       Boolean       @default(false)
  /// "Also sold in our stores" — display only, never a live stock claim.
  availableInRetail Boolean       @default(false)
  /// For short-shelf-life items unsuited to shipping.
  retailOnly        Boolean       @default(false)

  // --- Required for EVERY regulatory type ---
  /// Veg/non-veg logo. Not defaulted: for gummies this depends on gelatin vs.
  /// pectin/agar, which is an unresolved formulation fact (Section 14).
  isVeg          Boolean?
  allergens      String[] @default([])
  /// [MOVED] Total shelf life from manufacture. The brief placed this in the
  /// food-only block, but health supplements are food products under the FSS
  /// Act, 2006, so the "any food article" delivery rule reaches them too.
  /// Required for all three types at the validation layer — see
  /// src/lib/checkout/quote.ts for the scope reasoning and the counsel flag.
  shelfLifeDays  Int?

  // --- Food-specific (regulatoryType = PACKAGED_FOOD | BEVERAGE) ---
  /// { calories, protein, carbs, sugar, fat, sodium, fiber, ... } per serving.
  nutritionFacts Json?

  // --- Supplement-specific (regulatoryType = HEALTH_SUPPLEMENT) ---
  servingsPerContainer Int?
  /// "1 gummy daily" style — must carry explicit do-not-exceed language.
  dosageGuidance       String?
  /// { ingredient: { amountPerServing, percentRDA } }
  supplementFacts      Json?
  /// Grams of sugar per serving, shown as a number on the product page and
  /// card. Required for supplements (validation/product.ts); food takes it
  /// from nutritionFacts.totalSugarsG. No peer in the field study shows it.
  sugarPerServingG     Decimal? @db.Decimal(6, 2)
  /// Age suitability, in years. Required for Kids Vault products (saveProduct).
  suitableFromAge      Int?
  suitableToAge        Int?

  /// [ADDED] Set by the admin before a HEALTH_SUPPLEMENT product may go live.
  /// Section 7.5's forcing function against accidental therapeutic claims.
  /// Cleared automatically whenever `description` changes.
  complianceReviewedAt DateTime?
  complianceReviewedBy String?

  // --- Label declarations (Legal Metrology (Packaged Commodities) Rules and
  // FSSAI labelling, as they apply to online listings). Optional on drafts,
  // required before a product goes live (validation/product.ts). ---
  manufacturerName    String?
  manufacturerAddress String?
  /// "Packed by" / "Marketed by" name and address, when not the manufacturer.
  packerDetails       String?
  countryOfOrigin     String?
  /// As printed on the pack: "150 g", "60 gummies (120 g)".
  netQuantity         String?
  /// Maximum retail price, inclusive of all taxes. Nothing may sell above it.
  mrp                 Decimal? @db.Decimal(10, 2)
  /// Ingredients in descending order of weight, as on the label.
  ingredients         String?

  metaTitle       String?
  metaDescription String?

  images            ProductImage[]
  variants          ProductVariant[]
  batches           ProductBatch[]
  reviews           Review[]
  orderItems        OrderItem[]
  cartItems         CartItem[]
  bundleEligibility BundleEligibleProduct[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([brandId, isActive])
  @@index([categoryId, isActive])
  @@index([regulatoryType])
}

/// FEFO stock plus the shelf-life-at-delivery rule (Section 2.3 / 7.2).
model ProductBatch {
  id                String      @id @default(cuid())
  productId         String
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNumber       String
  manufacturedOn    DateTime
  expiresOn         DateTime
  quantityReceived  Int
  quantityRemaining Int
  orderItems        OrderItem[] // [FIX] back-relation — OrderItem.batchId is the recall-traceability link
  createdAt         DateTime    @default(now())

  @@unique([productId, batchNumber])
  @@index([productId, expiresOn])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)
}

/// Pack sizes — "200g" vs "500g", "30-count" vs "60-count".
model ProductVariant {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  skuSuffix     String
  priceOverride Decimal?    @db.Decimal(10, 2)
  stockQuantity Int         @default(0)
  isDefault     Boolean     @default(false)
  cartItems     CartItem[]
  orderItems    OrderItem[]
}

/// The True Store retail superstores (Section 2.4). Reference data the
/// storefront reads — address, hours, map pin. Never a live inventory feed.
model StoreLocation {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  latitude     Float?
  longitude    Float?
  phone        String?
  /// Free text or structured JSON — owner's call.
  openingHours String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Customer {
  id               String         @id @default(cuid())
  email            String         @unique
  phone            String?
  passwordHash     String?
  name             String
  emailVerifiedAt  DateTime?
  loyaltyPoints    Int            @default(0)
  /// Explicit, unchecked-by-default opt-in. A phone number collected for
  /// delivery updates is not permission to send offers (Section 8.5).
  marketingConsent Boolean        @default(false)
  whatsappOptIn    Boolean        @default(false)
  addresses        Address[]
  orders           Order[]
  cart             Cart?
  reviews          Review[]
  referralCode     ReferralCode?
  quizResponses    QuizResponse[]
  createdAt        DateTime       @default(now())
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String?
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("IN")
  phone      String
  isDefault  Boolean  @default(false)
}

model Cart {
  id         String     @id @default(cuid())
  customerId String?    @unique
  customer   Customer?  @relation(fields: [customerId], references: [id])
  sessionId  String?    @unique
  items      CartItem[]
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id         String          @id @default(cuid())
  cartId     String
  cart       Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  quantity   Int
  priceAtAdd Decimal         @db.Decimal(10, 2)
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id])
  guestEmail      String?
  guestPhone      String?
  status          OrderStatus @default(PENDING_PAYMENT)
  items           OrderItem[]
  events          OrderEvent[]
  /// Sum of lines at the price paid, after product-level discounts.
  subtotal        Decimal     @db.Decimal(10, 2)
  /// [ADDED] Saved through product-level discounts (list price minus price paid).
  productDiscountAmount Decimal @default(0) @db.Decimal(10, 2)
  /// [ADDED] Saved through bundle / combination offers.
  bundleDiscountAmount  Decimal @default(0) @db.Decimal(10, 2)
  bundleLabel     String?
  /// Coupon discount only.
  discountAmount  Decimal     @default(0) @db.Decimal(10, 2)
  shippingAmount  Decimal     @default(0) @db.Decimal(10, 2)
  taxAmount       Decimal     @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal     @db.Decimal(10, 2)
  couponCode      String?
  shippingAddress Json
  billingAddress  Json
  paymentGateway  String?
  paymentId       String?
  paymentStatus   String?
  /// The guest cart session this order was placed from (src/server/cart.ts).
  /// Nothing reads it for order fulfilment — it exists so the Razorpay
  /// webhook, which arrives as a server-to-server call with no session cookie
  /// of its own, can still record ORDER_PAID against the same funnel session
  /// that recorded PRODUCT_VIEW / ADD_TO_CART / CHECKOUT_STARTED earlier.
  sessionId       String?
  /// Unguessable secret required to view /order/[orderNumber]. The order
  /// number alone is a timestamp plus ~1,300 combinations — enumerable — and
  /// that page shows the customer's name and address. Null on orders placed
  /// before this existed; those pages simply stop being viewable.
  accessToken     String?     @unique
  trackingNumber  String?
  courierPartner  String?
  /// The delivery date shown to the shopper at checkout, kept so on-time
  /// delivery can be measured against what was actually promised.
  promisedDeliveryDate DateTime?
  deliveredAt     DateTime?
  /// Set when an order ends as CANCELLED, RTO or RETURNED.
  closedAt        DateTime?
  /// Why it ended: a code from CLOSE_REASONS in src/lib/order-lifecycle.ts.
  closeReason     String?
  /// GST tax invoice, issued when the order ships: consecutive per financial
  /// year, so orders cancelled before dispatch leave no gaps in the series.
  invoiceNumber   String?     @unique
  invoiceDate     DateTime?
  placedAt        DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status, placedAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  /// [FIX] Promoted from a bare String to a real relation. This is the recall
  /// traceability link — "which batch went to which customer" is the question
  /// you must answer under time pressure, and a dangling string id cannot
  /// guarantee the batch row still exists.
  batchId String?
  batch   ProductBatch? @relation(fields: [batchId], references: [id])

  productNameSnapshot String
  unitPriceSnapshot   Decimal @db.Decimal(10, 2)
  /// [ADDED] Undiscounted unit price at purchase, so the bill can show the saving.
  listUnitPriceSnapshot Decimal? @db.Decimal(10, 2)
  quantity            Int
  lineTotal           Decimal @db.Decimal(10, 2)
  /// Tax facts at the moment of sale, for the GST invoice: the product's own
  /// rate or HSN may change later, and the invoice must not.
  hsnCode             String?
  taxRatePercent      Decimal? @db.Decimal(4, 2)
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  minOrderValue Decimal?     @db.Decimal(10, 2)
  maxUses       Int?
  usedCount     Int          @default(0)
  validFrom     DateTime
  validUntil    DateTime
  isActive      Boolean      @default(true)
}

/// Gift hampers for The True Store; "build your routine" kits for the gummies brands.
model Bundle {
  id               String                 @id @default(cuid())
  brandId          String
  brand            Brand                  @relation(fields: [brandId], references: [id])
  slug             String                 @unique
  /// e.g. "Diwali Namkeen Hamper", "Build Your Kids Vault Kit"
  name             String
  description      String?
  minItems         Int                    @default(2)
  maxItems         Int?
  discountType     DiscountType
  discountValue    Decimal                @db.Decimal(10, 2)
  eligibleProducts BundleEligibleProduct[]
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
}

model BundleEligibleProduct {
  id        String  @id @default(cuid())
  bundleId  String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@unique([bundleId, productId])
}

model ReferralCode {
  id             String   @id @default(cuid())
  customerId     String   @unique
  customer       Customer @relation(fields: [customerId], references: [id])
  code           String   @unique
  referrerReward Decimal  @default(0) @db.Decimal(10, 2)
  refereeReward  Decimal  @default(0) @db.Decimal(10, 2)
  timesRedeemed  Int      @default(0)
  createdAt      DateTime @default(now())
}

/// Gummies brands only (Decision #8). Scoring logic and result copy come from
/// the business, not the build agent (Section 14).
model QuizResponse {
  id                    String    @id @default(cuid())
  brandId               String
  brand                 Brand     @relation(fields: [brandId], references: [id])
  customerId            String?
  customer              Customer? @relation(fields: [customerId], references: [id])
  answers               Json
  recommendedCategoryId String?
  recommendedCategory   Category? @relation(fields: [recommendedCategoryId], references: [id])
  createdAt             DateTime  @default(now())
}

model Review {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  customerName String
  rating       Int
  comment      String
  isApproved   Boolean   @default(false)
  createdAt    DateTime  @default(now())
}

model AdminUser {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  name         String
  role         AdminRole       @default(STAFF)
  mfaSecret    String?
  isActive     Boolean         @default(true)
  lastLoginAt  DateTime?
  /// Bumped on reset access and deactivation. Sessions carry the value they
  /// were issued with, and requirePermission rejects a mismatch, so a lost
  /// phone that is still signed in is signed out the moment access is reset.
  sessionVersion Int         @default(0)
  auditLogs    AdminAuditLog[]
  createdAt    DateTime        @default(now())
}

/// Append-only: a database trigger (see migration
/// 20260924010000_audit_trail) rejects UPDATE and DELETE, so an account that
/// can change data can't also erase the record of having changed it. Admins
/// with history therefore can't be deleted — deactivate them instead.
model AdminAuditLog {
  id          String     @id @default(cuid())
  /// Null only for failed sign-ins against an email that isn't an admin.
  adminUserId String?
  /// Restrict, not the optional-relation default of SetNull: deleting an
  /// admin must not silently strip their name off everything they did.
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  /// Email at the time of the action, so the record stays readable even if
  /// the account is later renamed.
  actorEmail  String?
  action      String
  entityType  String
  entityId    String
  /// For edits: { field: { from, to } } for changed fields only.
  changes     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime   @default(now())

  @@index([entityType, entityId])
  @@index([adminUserId, createdAt])
  @@index([createdAt])
}

/// What happened to an order, in order — the timeline on the admin order
/// page. Covers events with no admin behind them (placed by the customer,
/// paid via the Razorpay webhook), which the admin audit log can't hold.
model OrderEvent {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// PLACED | PAYMENT_CAPTURED | PAYMENT_FAILED | REFUNDED | STATUS_CHANGED | EMAIL_SENT | NOTE
  type       String
  /// CUSTOMER | SYSTEM | ADMIN
  actorType  String
  actorEmail String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
}

/// A funnel step, keyed by the same guest session cookie the cart already
/// uses (see src/server/cart.ts) rather than a new identifier — one fewer
/// cookie, and it means a session's cart activity and its funnel events are
/// already joined by construction.
enum AnalyticsEventType {
  VISIT
  PRODUCT_VIEW
  ADD_TO_CART
  CHECKOUT_STARTED
  ORDER_PLACED
  ORDER_PAID
  /// Storefront interactions recorded from the browser via /api/analytics/event
  /// (allowlisted in src/lib/client-events.ts).
  CART_OPENED
  OFFER_SHOWN
  OFFER_APPLIED
  CHECKOUT_STEP
  PAYMENT_METHOD_SELECTED
}

/// Funnel and abandonment tracking (Section: analytics). Write-heavy,
/// read-rarely — admin-only aggregate reads, so no relation load is attached
/// to Product/Order; a raw id is enough to join when a report needs to.
model AnalyticsEvent {
  id        String             @id @default(cuid())
  sessionId String
  type      AnalyticsEventType
  productId String?
  orderId   String?
  /// Free-form context — e.g. { value: totalPaise } on ORDER_PAID, so revenue
  /// can be read off the funnel without a join back to Order.
  metadata  Json?
  createdAt DateTime           @default(now())

  @@index([type, createdAt])
  @@index([sessionId, type])
}

/// Last invoice number issued in each financial year ("2026-27"). Incremented
/// inside the transaction that ships the order, so numbers are unique and
/// consecutive with no gaps.
model InvoiceSequence {
  financialYear String @id
  lastNumber    Int    @default(0)
}

/// The seller's own details, shown on the site and printed on invoices. One
/// row (id "default"), edited by the owner on Settings → Business details.
/// Everything is optional until filled in; the launch-readiness check lists
/// what's still missing, and orders stay blocked until it's complete.
model BusinessProfile {
  id                          String   @id @default("default")
  legalName                   String?
  /// Brand the customer sees, if different from the legal name.
  tradeName                   String?
  registeredAddress           String?
  gstin                       String?
  fssaiLicence                String?
  customerCarePhone           String?
  customerCareEmail           String?
  /// Required on the site by the Consumer Protection (E-Commerce) Rules, 2020.
  grievanceOfficerName        String?
  grievanceOfficerDesignation String?
  grievanceOfficerPhone       String?
  grievanceOfficerEmail       String?
  updatedAt                   DateTime @updatedAt
}

/// Proof of consent under the Digital Personal Data Protection Act, 2023:
/// who agreed to what, when, where, and the exact wording they were shown.
/// Append-only in practice; a withdrawal is a new row with granted = false.
model ConsentRecord {
  id         String   @id @default(cuid())
  /// "MARKETING" for now.
  purpose    String
  granted    Boolean
  email      String?
  phone      String?
  /// The exact text shown next to the checkbox.
  noticeText String
  /// Where it was given: "checkout".
  source     String
  orderId    String?
  createdAt  DateTime @default(now())

  @@index([email, purpose, createdAt])
}
