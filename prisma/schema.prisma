// =============================================================================
// SooulOne — data layer (build prompt Section 6)
//
// This is the Section 6 schema with the corrections needed to make it a valid,
// migratable Prisma schema. Every deviation from the document is marked
// [FIX] or [ADDED] with the reason, so the brief and the code can be diffed.
//
// [FIX] The document writes the datasource block inline with semicolons
//       (`datasource db { provider = "postgresql"; url = env("DATABASE_URL") }`).
//       Prisma's grammar has no statement separator — this must be multi-line.
// [FIX] Several relations in the document are declared on only one side.
//       Prisma requires both. Back-relations added on Brand, Category and
//       ProductBatch; each is marked below.
// [FIX] Prisma ORM 7 removed `datasource.url` from schema.prisma entirely —
//       it now belongs in prisma.config.ts, alongside the driver adapter that
//       v7 also requires for every relational database. See prisma.config.ts
//       and src/lib/db.ts, and the README's "found while building" section
//       for why this isn't simply a preference.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// What each role may do lives in src/lib/permissions.ts. STAFF predates the
/// finer roles and is kept as the least-privileged default: view-only.
enum AdminRole {
  OWNER
  STAFF
  MANAGER
  FULFILMENT
  CONTENT
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  FAILED
  /// Return to origin: the parcel came back undelivered (refused at the door,
  /// unreachable, bad address). The main cost of cash on delivery.
  RTO
  /// Delivered, then sent back by the customer.
  RETURNED
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

/// Drives which label fields the admin form makes mandatory and which
/// copy-guardrails apply. See build prompt Section 2.3 — packaged food and
/// health supplements sit under different FSSAI rule sets, and collapsing them
/// into one "product" shape is how a mandatory allergen field ships blank.
enum RegulatoryType {
  PACKAGED_FOOD
  HEALTH_SUPPLEMENT
  BEVERAGE
}

model Brand {
  id            String         @id @default(cuid())
  /// "the-true-store" | "woman-axis" | "kids-vault" | "man-rituals" | future lines
  slug          String         @unique
  name          String
  tagline       String?
  /// Brand accent colour. Seeded as a neutral placeholder until the brand kit exists —
  /// the seed script does not invent brand colours (Section 14).
  colorToken    String
  description   String?
  /// True for The True Store — the only brand operating physical superstores.
  isRetailBrand Boolean        @default(false)
  isActive      Boolean        @default(true)
  /// The brand's own web address, e.g. "womanaxis.in" (no https, no www).
  /// What it does is domainMode (src/lib/brand-domains.ts). Null: none.
  domain        String?        @unique
  domainMode    BrandDomainMode @default(OFF)
  /// Social profiles, full https links. Null: not shown.
  instagramUrl  String?
  facebookUrl   String?
  xUrl          String?
  youtubeUrl    String?
  articles      Article[]
  faqs          FaqEntry[]
  categories    Category[]
  products      Product[]
  bundles       Bundle[] // [FIX] back-relation for Bundle.brand
  quizResponses QuizResponse[] // [FIX] back-relation for QuizResponse.brand
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Category {
  id                  String         @id @default(cuid())
  brandId             String
  brand               Brand          @relation(fields: [brandId], references: [id])
  slug                String
  /// e.g. "Hair Fall" (Man Rituals), "Healthy Namkeen" (True Store — proposed, confirm)
  name                String
  description         String?
  imageUrl            String?
  sortOrder           Int            @default(0)
  isActive            Boolean        @default(true)
  products            Product[]
  quizRecommendations QuizResponse[] // [FIX] back-relation for QuizResponse.recommendedCategory
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([brandId, slug])
}

model Product {
  id                String         @id @default(cuid())
  sku               String         @unique
  name              String
  slug              String         @unique
  brandId           String
  brand             Brand          @relation(fields: [brandId], references: [id])
  categoryId        String
  category          Category       @relation(fields: [categoryId], references: [id])
  regulatoryType    RegulatoryType
  shortDescription  String
  /// Markdown. For HEALTH_SUPPLEMENT this must stay in structure/function language
  /// ("supports", "helps maintain") and never therapeutic language ("treats",
  /// "cures", "prevents"). Enforced at the admin boundary — see src/lib/compliance/claims.ts.
  description       String
  basePrice         Decimal        @db.Decimal(10, 2)
  compareAtPrice    Decimal?       @db.Decimal(10, 2)
  /// [ADDED] Percentage-off promotion. `basePrice` stays the undiscounted price;
  /// the shopper pays basePrice less `discountPercent` while `discountActive`.
  discountActive    Boolean        @default(false)
  discountPercent   Decimal?       @db.Decimal(5, 2)
  hsnCode           String?
  taxRatePercent    Decimal        @default(18) @db.Decimal(4, 2)
  /// What one unit costs SooulOne, landed. Finance-only; never shown to
  /// shoppers. The box editor uses it to refuse boxes that could sell below cost.
  unitCost          Decimal?       @db.Decimal(10, 2)
  /// ONLINE stock only. Retail superstore stock is deliberately out of scope
  /// (Decision #3) — this number never represents in-store availability.
  stockQuantity     Int            @default(0)
  boxProducts       BoxProduct[]
  cartBoxItems      CartBoxItem[]
  lowStockThreshold Int            @default(10)
  weightGrams       Int?
  isActive          Boolean        @default(true)
  isFeatured        Boolean        @default(false)
  isOfferZone       Boolean        @default(false)
  /// "Also sold in our stores" — display only, never a live stock claim.
  availableInRetail Boolean        @default(false)
  /// For short-shelf-life items unsuited to shipping.
  retailOnly        Boolean        @default(false)

  // --- Required for EVERY regulatory type ---
  /// Veg/non-veg logo. Not defaulted: for gummies this depends on gelatin vs.
  /// pectin/agar, which is an unresolved formulation fact (Section 14).
  isVeg         Boolean?
  allergens     String[] @default([])
  /// [MOVED] Total shelf life from manufacture. The brief placed this in the
  /// food-only block, but health supplements are food products under the FSS
  /// Act, 2006, so the "any food article" delivery rule reaches them too.
  /// Required for all three types at the validation layer — see
  /// src/lib/checkout/quote.ts for the scope reasoning and the counsel flag.
  shelfLifeDays Int?

  // --- Food-specific (regulatoryType = PACKAGED_FOOD | BEVERAGE) ---
  /// { calories, protein, carbs, sugar, fat, sodium, fiber, ... } per serving.
  nutritionFacts Json?

  // --- Supplement-specific (regulatoryType = HEALTH_SUPPLEMENT) ---
  servingsPerContainer Int?
  /// Servings taken a day ("chew 2 gummies daily" is 2), so a pack's run-out
  /// date can be worked out for refill reminders. Blank: no reminder offered.
  servingsPerDay       Int?
  /// "1 gummy daily" style — must carry explicit do-not-exceed language.
  dosageGuidance       String?
  /// { ingredient: { amountPerServing, percentRDA } }
  supplementFacts      Json?
  /// Grams of sugar per serving, shown as a number on the product page and
  /// card. Required for supplements (validation/product.ts); food takes it
  /// from nutritionFacts.totalSugarsG. No peer in the field study shows it.
  sugarPerServingG     Decimal? @db.Decimal(6, 2)
  /// Age suitability, in years. Required for Kids Vault products (saveProduct).
  suitableFromAge      Int?
  suitableToAge        Int?

  /// [ADDED] Set by the admin before a HEALTH_SUPPLEMENT product may go live.
  /// Section 7.5's forcing function against accidental therapeutic claims.
  /// Cleared automatically whenever `description` changes.
  complianceReviewedAt DateTime?
  complianceReviewedBy String?

  // --- Label declarations (Legal Metrology (Packaged Commodities) Rules and
  // FSSAI labelling, as they apply to online listings). Optional on drafts,
  // required before a product goes live (validation/product.ts). ---
  manufacturerName    String?
  manufacturerAddress String?
  /// "Packed by" / "Marketed by" name and address, when not the manufacturer.
  packerDetails       String?
  /// Who made it (Suppliers). Its FSSAI licence number is shown on the
  /// product page, and a product can't go live without one (Labelling and
  /// Display Regs 2020, reg 5(7)(b)). manufacturerName/Address above are kept
  /// in step with it on save.
  manufacturerId      String?
  manufacturer        Supplier?    @relation("ProductManufacturer", fields: [manufacturerId], references: [id], onDelete: Restrict)
  /// Who packs or markets it, when a different firm: its licence is shown too.
  marketerId          String?
  marketer            Supplier?    @relation("ProductMarketer", fields: [marketerId], references: [id], onDelete: Restrict)
  countryOfOrigin     String?
  /// As printed on the pack: "150 g", "60 gummies (120 g)".
  netQuantity         String?
  /// Maximum retail price, inclusive of all taxes. Nothing may sell above it.
  mrp                 Decimal? @db.Decimal(10, 2)
  /// Ingredients in descending order of weight, as on the label.
  ingredients         String?

  metaTitle       String?
  metaDescription String?

  images            ProductImage[]
  variants          ProductVariant[]
  batches           ProductBatch[]
  reviews           Review[]
  stockAlerts       StockAlert[]
  orderItems        OrderItem[]
  cartItems         CartItem[]
  bundleEligibility BundleEligibleProduct[]
  articles          Article[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([brandId, isActive])
  @@index([categoryId, isActive])
  @@index([regulatoryType])
}

/// FEFO stock plus the shelf-life-at-delivery rule (Section 2.3 / 7.2).
model ProductBatch {
  id                String      @id @default(cuid())
  productId         String
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNumber       String
  manufacturedOn    DateTime
  expiresOn         DateTime
  quantityReceived  Int
  quantityRemaining Int
  /// Set when the batch is recalled: the public batch check (/verify) then
  /// says so, with recallNote, instead of "within its best-before".
  recalledAt        DateTime?
  recallNote        String?
  /// Where this batch came from (Suppliers) and the paperwork for it, so a
  /// recall can be traced back to its source (FSSAI Schedule 4; FSS Act s.27(3)).
  supplierId        String?
  supplier          Supplier?   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  invoiceNumber     String?
  invoiceDate       DateTime?
  receivedOn        DateTime?
  /// The recall notice emailed to its buyers, and when (src/lib/recall.ts).
  recallNoticeText  String?
  recallNotifiedAt  DateTime?
  orderItems        OrderItem[] // [FIX] back-relation — OrderItem.batchId is the recall-traceability link
  createdAt         DateTime    @default(now())

  @@unique([productId, batchNumber])
  @@index([productId, expiresOn])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  @@index([productId, sortOrder])
}

/// Pack sizes — "200g" vs "500g", "30-count" vs "60-count".
model ProductVariant {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  skuSuffix     String
  priceOverride Decimal?    @db.Decimal(10, 2)
  stockQuantity Int         @default(0)
  isDefault     Boolean     @default(false)
  cartItems     CartItem[]
  orderItems    OrderItem[]
}

/// The True Store retail superstores (Section 2.4). Reference data the
/// storefront reads — address, hours, map pin. Never a live inventory feed.
model StoreLocation {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  latitude     Float?
  longitude    Float?
  phone        String?
  /// Free text or structured JSON — owner's call.
  openingHours String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

/// A shopper account. Created the first time someone proves they own a
/// mobile number with a one-time code (src/server/customer-auth.ts), never
/// from typed checkout details: anyone can type anyone's number.
model Customer {
  id               String            @id @default(cuid())
  /// A verified email only, for email or Google sign-in later. The email
  /// typed at checkout stays on the order (guestEmail), since two people can
  /// type the same one.
  email            String?           @unique
  /// 10 digits, no +91. Proven by one-time code before the row exists.
  phone            String?           @unique
  phoneVerifiedAt  DateTime?
  passwordHash     String?
  name             String            @default("")
  emailVerifiedAt  DateTime?
  lastSignInAt     DateTime?
  sessions         CustomerSession[]
  loyaltyPoints    Int               @default(0)
  /// Explicit, unchecked-by-default opt-in. A phone number collected for
  /// delivery updates is not permission to send offers (Section 8.5).
  marketingConsent Boolean           @default(false)
  whatsappOptIn    Boolean           @default(false)
  addresses        Address[]
  orders           Order[]
  cart             Cart?
  reviews          Review[]
  referralCode     ReferralCode?
  referralsMade    Referral[]        @relation("Referrer")
  referredBy       Referral?         @relation("Referee")
  walletEntries    WalletEntry[]
  quizResponses    QuizResponse[]
  savedBoxes       SavedBox[]
  stockAlerts      StockAlert[]
  createdAt        DateTime          @default(now())
}

/// A signed-in browser. Only a SHA-256 of the cookie's token is stored, so a
/// database leak can't be replayed as a sign-in. Deleting the row signs that
/// browser out; deleting all of a customer's rows is "sign out everywhere".
/// Separate from the owner console's sign-in on purpose (src/lib/auth.ts).
model CustomerSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userAgent  String?
  /// SHA-256 of the browser's basket-session id: lets a referral from the
  /// referrer's own browser be spotted without fingerprinting anyone.
  deviceHash String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([customerId])
}

/// A one-time code sent to a mobile number. The code is stored as an HMAC,
/// allows a few tries, expires in minutes and is used once
/// (src/lib/otp.ts). Old rows are pruned as new ones are made.
model PhoneOtp {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

/// A signed-in shopper's address book (benchmark gap C16): saved from each
/// order they place, offered at checkout, removable from the account page.
model Address {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Who it's for, as typed at checkout.
  name       String    @default("")
  label      String?
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String    @default("IN")
  phone      String
  isDefault  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  /// The last order that went here; the address book lists the latest first.
  lastUsedAt DateTime?

  @@index([customerId, lastUsedAt])
}

model Cart {
  id         String     @id @default(cuid())
  customerId String?    @unique
  customer   Customer?  @relation(fields: [customerId], references: [id])
  sessionId  String?    @unique
  items      CartItem[]
  boxes      CartBox[]
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id         String          @id @default(cuid())
  cartId     String
  cart       Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  quantity   Int
  priceAtAdd Decimal         @db.Decimal(10, 2)

  // Postgres doesn't index foreign keys by itself (DR review, 2026-09-26).
  @@index([cartId])
  @@index([productId])
}

model Order {
  id                    String       @id @default(cuid())
  orderNumber           String       @unique
  customerId            String?
  customer              Customer?    @relation(fields: [customerId], references: [id])
  guestEmail            String?
  guestPhone            String?
  /// When guestPhone was proven by one-time code for this order (required for
  /// cash on delivery once SMS is set up). Null means it was only typed.
  phoneVerifiedAt       DateTime?
  status                OrderStatus  @default(PENDING_PAYMENT)
  items                 OrderItem[]
  events                OrderEvent[]
  messages              OutboundMessage[]
  reviews               Review[]
  /// Sum of lines at the price paid, after product-level discounts.
  subtotal              Decimal      @db.Decimal(10, 2)
  /// [ADDED] Saved through product-level discounts (list price minus price paid).
  productDiscountAmount Decimal      @default(0) @db.Decimal(10, 2)
  /// [ADDED] Saved through bundle / combination offers.
  bundleDiscountAmount  Decimal      @default(0) @db.Decimal(10, 2)
  bundleLabel           String?
  /// The Make Your Own Boxes in it, as [{ boxId, name, picks: [{ productId,
  /// quantity }] }]. Its items are order lines like any other; this lets
  /// "Order again" put each box back as a box (src/lib/reorder.ts).
  boxSnapshot           Json?
  /// Coupon discount only.
  discountAmount        Decimal      @default(0) @db.Decimal(10, 2)
  /// Referral credit or a referred friend's welcome discount (never with a coupon).
  creditAmount          Decimal      @default(0) @db.Decimal(10, 2)
  /// "WALLET" (the referrer spending credit) or "WELCOME" (a friend's first order).
  creditKind            String?
  shippingAmount        Decimal      @default(0) @db.Decimal(10, 2)
  taxAmount             Decimal      @default(0) @db.Decimal(10, 2)
  totalAmount           Decimal      @db.Decimal(10, 2)
  couponCode            String?
  shippingAddress       Json
  billingAddress        Json
  paymentGateway        String?
  paymentId             String?
  paymentStatus         String?
  /// The guest cart session this order was placed from (src/server/cart.ts).
  /// Nothing reads it for order fulfilment — it exists so the Razorpay
  /// webhook, which arrives as a server-to-server call with no session cookie
  /// of its own, can still record ORDER_PAID against the same funnel session
  /// that recorded PRODUCT_VIEW / ADD_TO_CART / CHECKOUT_STARTED earlier.
  sessionId             String?
  /// One checkout attempt, sent by the browser as Idempotency-Key: a double
  /// click or a network retry gets the first order back instead of a second one.
  idempotencyKey        String?      @unique
  /// Unguessable secret required to view /order/[orderNumber]. The order
  /// number alone is a timestamp plus ~1,300 combinations — enumerable — and
  /// that page shows the customer's name and address. Null on orders placed
  /// before this existed; those pages simply stop being viewable.
  accessToken           String?      @unique
  trackingNumber        String?
  courierPartner        String?
  /// The delivery date shown to the shopper at checkout, kept so on-time
  /// delivery can be measured against what was actually promised.
  promisedDeliveryDate  DateTime?
  deliveredAt           DateTime?
  /// When the shopper asked for a refill reminder on this order (benchmark
  /// gap R2, src/server/refill-reminders.ts); cleared when they stop them.
  refillOptInAt         DateTime?
  /// Set when an order ends as CANCELLED, RTO or RETURNED.
  closedAt              DateTime?
  /// Why it ended: a code from CLOSE_REASONS in src/lib/order-lifecycle.ts.
  closeReason           String?
  /// GST tax invoice, issued when the order ships: consecutive per financial
  /// year, so orders cancelled before dispatch leave no gaps in the series.
  invoiceNumber         String?      @unique
  invoiceDate           DateTime?
  /// The seller's details as they stood when the invoice was issued (name,
  /// address, GSTIN, FSSAI, contact): an issued GST invoice never changes when
  /// Business details do. See sellerSnapshot in src/lib/invoice.ts.
  sellerSnapshot        Json?
  /// Where the shopper came from: the first visit and the latest campaign or
  /// outside site before the order (src/lib/attribution.ts). Null: no record.
  attribution           Json?
  /// GST on the delivery charge, and whether tax was CGST+SGST (INTRA_STATE)
  /// or IGST (INTER_STATE), as charged at checkout.
  shippingTaxAmount     Decimal?     @db.Decimal(10, 2)
  gstTreatment          String?
  /// The delivery pincode, copied out of shippingAddress so pincode reports
  /// and the checkout's COD rules can use an index (src/lib/intel/pincodes.ts).
  postalCode            String?
  /// Return-to-origin risk, 0–100, worked out when the order was placed
  /// (src/lib/intel/rto-risk.ts), and the reasons behind it.
  riskScore             Int?
  riskReasons           Json?
  placedAt              DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([status, placedAt])
  @@index([postalCode, placedAt])
  /// The Razorpay webhook and reconciliation find orders by payment id.
  @@index([paymentId])
  /// Repeat-customer analytics and support look-ups by email.
  @@index([guestEmail, placedAt])
  /// A shopper's account page lists their orders, newest first.
  @@index([customerId, placedAt])
  /// Signing in links earlier guest orders placed with the same number.
  @@index([guestPhone, placedAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  /// [FIX] Promoted from a bare String to a real relation. This is the recall
  /// traceability link — "which batch went to which customer" is the question
  /// you must answer under time pressure, and a dangling string id cannot
  /// guarantee the batch row still exists.
  batchId String?
  batch   ProductBatch? @relation(fields: [batchId], references: [id])

  productNameSnapshot   String
  unitPriceSnapshot     Decimal  @db.Decimal(10, 2)
  /// [ADDED] Undiscounted unit price at purchase, so the bill can show the saving.
  listUnitPriceSnapshot Decimal? @db.Decimal(10, 2)
  quantity              Int
  lineTotal             Decimal  @db.Decimal(10, 2)
  /// Tax facts at the moment of sale, for the GST invoice: the product's own
  /// rate or HSN may change later, and the invoice must not.
  hsnCode               String?
  taxRatePercent        Decimal? @db.Decimal(4, 2)
  /// This row's share of the line's value after every discount, split into
  /// taxable value and GST exactly as checkout charged it.
  taxableAmount         Decimal? @db.Decimal(10, 2)
  taxAmount             Decimal? @db.Decimal(10, 2)

  /// What was decided when the parcel came back (RTO or returned): src/lib/returns.ts.
  returnCheck ReturnCheck?

  @@index([orderId])
  @@index([productId])
  /// Recall tracing: which orders received this batch.
  @@index([batchId])
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  minOrderValue Decimal?     @db.Decimal(10, 2)
  maxUses       Int?
  usedCount     Int          @default(0)
  validFrom     DateTime
  validUntil    DateTime
  isActive      Boolean      @default(true)
}

/// Gift hampers for The True Store; "build your routine" kits for the gummies brands.
model Bundle {
  id               String                  @id @default(cuid())
  brandId          String
  brand            Brand                   @relation(fields: [brandId], references: [id])
  slug             String                  @unique
  /// e.g. "Diwali Namkeen Hamper", "Build Your Kids Vault Kit"
  name             String
  description      String?
  minItems         Int                     @default(2)
  maxItems         Int?
  discountType     DiscountType
  discountValue    Decimal                 @db.Decimal(10, 2)
  /// Optional step-up: the discount (same type) when a kit holds one more product
  /// than minItems, e.g. 12% for 2 products and 15% for 3. Set, maxItems is minItems + 1.
  stepUpValue      Decimal?                @db.Decimal(10, 2)
  eligibleProducts BundleEligibleProduct[]
  isActive         Boolean                 @default(true)
  createdAt        DateTime                @default(now())
}

model BundleEligibleProduct {
  id        String  @id @default(cuid())
  bundleId  String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@unique([bundleId, productId])
  @@index([productId])
}

model ReferralCode {
  id             String     @id @default(cuid())
  customerId     String     @unique
  customer       Customer   @relation(fields: [customerId], references: [id])
  code           String     @unique
  referrerReward Decimal    @default(0) @db.Decimal(10, 2)
  refereeReward  Decimal    @default(0) @db.Decimal(10, 2)
  /// Rewards paid out through this code; stops at the programme's cap.
  timesRedeemed  Int        @default(0)
  isActive       Boolean    @default(true)
  referrals      Referral[]
  createdAt      DateTime   @default(now())
}

/// Gummies brands only (Decision #8). Scoring logic and result copy come from
/// the business, not the build agent (Section 14).
model QuizResponse {
  id                    String    @id @default(cuid())
  brandId               String
  brand                 Brand     @relation(fields: [brandId], references: [id])
  customerId            String?
  customer              Customer? @relation(fields: [customerId], references: [id])
  answers               Json
  recommendedCategoryId String?
  recommendedCategory   Category? @relation(fields: [recommendedCategoryId], references: [id])
  createdAt             DateTime  @default(now())
}

model Review {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  customerName String
  rating       Int
  comment      String
  isApproved   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  /// The order it was written from (the order page or the day-14 email),
  /// which makes it a "Verified buyer" review. Null for reviews left on a
  /// product page. One review per product per order.
  orderId      String?
  order        Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([orderId, productId])
  @@index([productId, isApproved])
}

model AdminUser {
  id             String              @id @default(cuid())
  email          String              @unique
  passwordHash   String
  name           String
  role           AdminRole           @default(STAFF)
  mfaSecret      String?
  isActive       Boolean             @default(true)
  lastLoginAt    DateTime?
  /// Bumped on reset access and deactivation. Sessions carry the value they
  /// were issued with, and requirePermission rejects a mismatch, so a lost
  /// phone that is still signed in is signed out the moment access is reset.
  sessionVersion Int                 @default(0)
  auditLogs      AdminAuditLog[]
  recoveryCodes  AdminRecoveryCode[]
  createdAt      DateTime            @default(now())
}

/// Append-only: a database trigger (see migration
/// 20260924010000_audit_trail) rejects UPDATE and DELETE, so an account that
/// can change data can't also erase the record of having changed it. Admins
/// with history therefore can't be deleted — deactivate them instead.
model AdminAuditLog {
  id          String     @id @default(cuid())
  /// Null only for failed sign-ins against an email that isn't an admin.
  adminUserId String?
  /// Restrict, not the optional-relation default of SetNull: deleting an
  /// admin must not silently strip their name off everything they did.
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  /// Email at the time of the action, so the record stays readable even if
  /// the account is later renamed.
  actorEmail  String?
  action      String
  entityType  String
  entityId    String
  /// For edits: { field: { from, to } } for changed fields only.
  changes     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime   @default(now())

  @@index([entityType, entityId])
  @@index([adminUserId, createdAt])
  @@index([createdAt])
}

/// What happened to an order, in order — the timeline on the admin order
/// page. Covers events with no admin behind them (placed by the customer,
/// paid via the Razorpay webhook), which the admin audit log can't hold.
model OrderEvent {
  id         String          @id @default(cuid())
  orderId    String
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       OrderEventType
  actorType  OrderEventActor
  actorEmail String?
  detail     Json?
  createdAt  DateTime        @default(now())

  @@index([orderId, createdAt])
}

/// What happened on an order's timeline (src/lib/order-events.ts).
enum OrderEventType {
  PLACED
  PAYMENT_CAPTURED
  PAYMENT_FAILED
  REFUNDED
  STATUS_CHANGED
  EMAIL_SENT
  NOTE
}

/// Who made an order event happen.
enum OrderEventActor {
  CUSTOMER
  SYSTEM
  ADMIN
}

/// A funnel step, keyed by the same guest session cookie the cart already
/// uses (see src/server/cart.ts) rather than a new identifier — one fewer
/// cookie, and it means a session's cart activity and its funnel events are
/// already joined by construction.
enum AnalyticsEventType {
  VISIT
  PRODUCT_VIEW
  ADD_TO_CART
  CHECKOUT_STARTED
  ORDER_PLACED
  ORDER_PAID
  /// Storefront interactions recorded from the browser via /api/analytics/event
  /// (allowlisted in src/lib/client-events.ts).
  CART_OPENED
  OFFER_SHOWN
  OFFER_APPLIED
  CHECKOUT_STEP
  PAYMENT_METHOD_SELECTED
  /// A pincode typed at checkout: { pincode, serviceable }. Recorded by the
  /// server (/api/pincode), so demand from outside the delivery area shows.
  PINCODE_CHECKED
  /// The shopper closed the payment window without paying (browser event).
  PAYMENT_DISMISSED
  /// A storefront assistant question, by intent only: { intent } (no free text kept).
  ASSISTANT_INTENT
  /// A batch number checked on /verify: { batch, found } (normalised code only).
  BATCH_CHECKED
  /// A storefront search: { q, results } (digit runs stripped, so no phone numbers).
  SEARCHED
}

/// Funnel and abandonment tracking (Section: analytics). Write-heavy,
/// read-rarely — admin-only aggregate reads, so no relation load is attached
/// to Product/Order; a raw id is enough to join when a report needs to.
model AnalyticsEvent {
  id        String             @id @default(cuid())
  sessionId String
  type      AnalyticsEventType
  productId String?
  orderId   String?
  /// Free-form context — e.g. { value: totalPaise } on ORDER_PAID, so revenue
  /// can be read off the funnel without a join back to Order.
  metadata  Json?
  createdAt DateTime           @default(now())

  @@index([type, createdAt])
  @@index([sessionId, type])
}

/// Last invoice number issued in each financial year ("2026-27"). Incremented
/// inside the transaction that ships the order, so numbers are unique and
/// consecutive with no gaps.
model InvoiceSequence {
  financialYear String @id
  lastNumber    Int    @default(0)
}

/// The seller's own details, shown on the site and printed on invoices. One
/// row (id "default"), edited by the owner on Settings → Business details.
/// Everything is optional until filled in; the launch-readiness check lists
/// what's still missing, and orders stay blocked until it's complete.
model BusinessProfile {
  id                          String   @id @default("default")
  legalName                   String?
  /// Brand the customer sees, if different from the legal name.
  tradeName                   String?
  registeredAddress           String?
  gstin                       String?
  fssaiLicence                String?
  customerCarePhone           String?
  customerCareEmail           String?
  /// Required on the site by the Consumer Protection (E-Commerce) Rules, 2020.
  grievanceOfficerName        String?
  grievanceOfficerDesignation String?
  grievanceOfficerPhone       String?
  grievanceOfficerEmail       String?
  /// Corporate Identity Number, shown in the footer and on the contact page.
  cin                         String?
  /// Where post should go, if not the registered address.
  mailingAddress              String?
  /// SooulOne's own social profiles (each brand has its own on Brand).
  instagramUrl                String?
  facebookUrl                 String?
  xUrl                        String?
  youtubeUrl                  String?
  updatedAt                   DateTime @updatedAt
}

/// Proof of consent under the Digital Personal Data Protection Act, 2023:
/// who agreed to what, when, where, and the exact wording they were shown.
/// Append-only in practice; a withdrawal is a new row with granted = false.
model ConsentRecord {
  id         String   @id @default(cuid())
  /// "MARKETING" for now.
  purpose    String
  granted    Boolean
  email      String?
  phone      String?
  /// The exact text shown next to the checkbox.
  noticeText String
  /// Where it was given: "checkout".
  source     String
  orderId    String?
  createdAt  DateTime @default(now())

  @@index([email, purpose, createdAt])
}

/// Owner's switches for the live store (Settings → Store controls), so an
/// RTO spike, a stock problem or a holiday doesn't need a code change. One
/// row (id "default"); every change is in the activity log.
model StoreSettings {
  id                 String     @id @default("default")
  /// Stops new orders at checkout, showing pauseMessage.
  ordersPaused       Boolean    @default(false)
  pauseMessage       String?
  /// Cash on delivery offered at checkout.
  codEnabled         Boolean    @default(true)
  /// Bundle offers applied in the basket and checkout.
  bundlesEnabled     Boolean    @default(true)
  /// Shoppers get a Day/Night switch on the storefront (src/lib/theme.ts).
  themeToggleVisible Boolean    @default(true)
  /// The storefront's theme while the switch is hidden.
  forcedTheme        StoreTheme @default(LIGHT)
  /// Cash on delivery only from this order total (₹, incl. GST): on a small
  /// order, one refused parcel costs more than several delivered ones earn. Null: no floor.
  codMinOrderValue   Int?
  /// Cash on delivery only up to this order total (₹, incl. GST). Null: no cap.
  codMaxOrderValue   Int?
  /// Which way to pay checkout selects first.
  preferredPayment   PaymentPreference @default(ONLINE)
  /// Delivery charge on an order below freeDeliveryAbove (₹, incl. GST). 0: delivery is always free.
  deliveryFee        Int        @default(59)
  /// Delivery is free when the order, after discounts, reaches this (₹, incl. GST).
  freeDeliveryAbove  Int        @default(799)
  /// Turn cash on delivery off by itself for pincodes whose parcels keep
  /// coming back (src/lib/intel/pincodes.ts). Off until the owner opts in.
  codAutoBlock       Boolean    @default(false)
  /// ...when at least this share of shipped COD parcels came back (percent)...
  codAutoBlockRtoPercent Int    @default(35)
  /// ...out of at least this many shipped COD parcels, so one refusal can't block a pincode.
  codAutoBlockMinShipped Int    @default(4)
  /// The storefront assistant (src/components/storefront-bot.tsx) is shown.
  assistantEnabled   Boolean    @default(true)
  /// Days after delivery a return can be asked for, as the business has
  /// decided it. Null until set: the assistant then never states a window and
  /// hands the shopper to a person instead.
  returnWindowDays   Int?
  /// The business's own words on what can be returned (shown by the assistant).
  returnConditions   String?
  /// WhatsApp number for support hand-offs, 10 digits. Null: email only.
  supportWhatsapp    String?
  /// The owner's local AI copilot, reached through a tunnel (docs/COPILOT.md):
  /// its https address and the shared token it requires. Owner only.
  copilotUrl         String?
  copilotToken       String?
  updatedAt          DateTime   @updatedAt
}

enum PaymentPreference {
  ONLINE
  COD
}

/// The owner's rule for one pincode, set from Analytics → Pincodes. Every
/// change is in the activity log.
model PincodeRule {
  pincode       String   @id
  /// No cash on delivery to this pincode, whatever the automatic rule says.
  codBlocked    Boolean  @default(false)
  /// Allow cash on delivery here even if the automatic rule would block it.
  codAllowed    Boolean  @default(false)
  /// Days added to the delivery promise (a slow courier lane, a flood).
  extraDays     Int      @default(0)
  note          String?
  updatedAt     DateTime @updatedAt
  updatedBy     String?
}

/// Every online payment attempt Razorpay reports, captured or failed,
/// including retries on the same order, so payment health can be measured per
/// method (src/lib/intel/payment-health.ts). Written by the webhook.
model PaymentAttempt {
  id                String   @id @default(cuid())
  orderId           String?
  razorpayOrderId   String
  razorpayPaymentId String?
  /// upi, card, netbanking, wallet, emi, paylater (Razorpay's names).
  method            String?
  /// CAPTURED or FAILED.
  status            String
  /// Who Razorpay says caused a failure: customer, bank, gateway, business or
  /// internal. Customer-caused failures (a cancelled UPI request, a wrong OTP)
  /// are left out of payment health, so they can't look like an outage.
  errorSource       String?
  errorCode         String?
  errorReason       String?
  amountPaise       Int?
  createdAt         DateTime @default(now())

  /// A redelivered webhook records nothing new.
  @@unique([razorpayPaymentId, status])
  @@index([createdAt])
  @@index([method, createdAt])
}

/// A payment-method outage Razorpay announced (payment.downtime.* webhooks):
/// the fastest outage signal at low volume. Shown on Analytics → Payments and
/// as a note at checkout while it lasts.
model PaymentDowntime {
  /// Razorpay's downtime id.
  id         String    @id
  /// card, netbanking, upi, wallet...
  method     String
  /// Which bank, UPI app or card network, as Razorpay describes it.
  instrument Json?
  /// high: the whole method; medium: more declines than usual; low: minor.
  severity   String
  /// started, updated, resolved
  status     String
  beginAt    DateTime
  endAt      DateTime?
  updatedAt  DateTime  @updatedAt

  @@index([status, beginAt])
}

/// What was spent on marketing in a month (ads, influencers), entered by the
/// owner, so acquisition cost and LTV:CAC can be worked out.
model MarketingSpend {
  /// "2026-09"
  month     String   @id
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  updatedAt DateTime @updatedAt
}

enum StoreTheme {
  LIGHT
  DARK
}

/// Single-use backup codes for two-factor sign-in, for when the authenticator
/// phone is lost. Only a keyed fingerprint is stored (HMAC with the server's
/// JWT_SECRET, src/lib/recovery-codes.ts), so a copy of the database alone
/// can't be turned back into working codes.
model AdminRecoveryCode {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  codeHash    String
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@unique([adminUserId, codeHash])
}

/// Fixed-window attempt counters for sign-in and public endpoints
/// (src/server/rate-limit.ts). In the database so they survive deploys and are
/// shared by every app instance. Keys look like "signin:ip:1.2.3.4".
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime

  @@index([windowStart])
}

// ---------------------------------------------------------------------------
// Make Your Own Box: "pick any 3 for ₹999" across brands.
// ---------------------------------------------------------------------------

/// What a box may hold: gummies (any of the three gummies brands) or The True
/// Store's snacks. Never both: food and supplements stay in separate boxes.
enum BoxKind {
  GUMMIES
  TRUE_STORE
}

enum BoxSlotMode {
  /// Every sellable product in the slot's brands and price range.
  ALL
  /// Only products worth clearing: near their shipping cut-off, or slow to sell.
  CLEARANCE
}

enum BoxProductSource {
  RULE
  MANUAL
}

/// A mix-and-match box at one fixed price (src/lib/checkout/boxes.ts). Its
/// own model, not a kind of Bundle: kits take a percentage off one brand's
/// products, boxes charge a fixed price across brands, and the basket keeps
/// a box the shopper built apart from its product lines.
model Box {
  id              String       @id @default(cuid())
  slug            String       @unique
  name            String
  /// Set when the box is made and never changed (src/lib/checkout/boxes.ts).
  kind            BoxKind      @default(GUMMIES)
  description     String?
  /// The price of one complete box, GST included.
  price           Decimal      @db.Decimal(10, 2)
  /// Exactly this many items make a box.
  size            Int
  /// The same product at most this many times in one box.
  maxPerProduct   Int          @default(1)
  /// Owner's override for clearance boxes that may sell below cost; logged.
  allowBelowCost  Boolean      @default(false)
  isActive        Boolean      @default(false)
  poolRefreshedAt DateTime?
  slots           BoxSlot[]
  products        BoxProduct[]
  cartBoxes       CartBox[]
  savedBoxes      SavedBox[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

/// A section of the box page ("For her", "For kids") and the rule that fills it.
model BoxSlot {
  id             String       @id @default(cuid())
  boxId          String
  box            Box          @relation(fields: [boxId], references: [id], onDelete: Cascade)
  label          String
  hint           String?
  sortOrder      Int          @default(0)
  /// Picks this section needs before the box is complete (0 = optional).
  minPicks       Int          @default(0)
  maxPicks       Int?
  brandIds       String[]
  categoryIds    String[]
  minPrice       Decimal?     @db.Decimal(10, 2)
  maxPrice       Decimal?     @db.Decimal(10, 2)
  mode           BoxSlotMode  @default(ALL)
  /// CLEARANCE: shippable stock whose shipping cut-off is within this many days.
  nearExpiryDays Int?
  /// CLEARANCE: at least this many days of stock at the last 30 days' sales rate.
  minDaysOfCover Int?
  products       BoxProduct[]

  @@index([boxId])
}

/// The box's pool: rebuilt from the slot rules by the refresh
/// (src/server/boxes.ts); pins and exclusions survive it.
model BoxProduct {
  id          String           @id @default(cuid())
  boxId       String
  box         Box              @relation(fields: [boxId], references: [id], onDelete: Cascade)
  slotId      String
  slot        BoxSlot          @relation(fields: [slotId], references: [id], onDelete: Cascade)
  productId   String
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  source      BoxProductSource @default(RULE)
  excluded    Boolean          @default(false)
  /// Why the rule picked it ("near cut-off: 41 days"), shown to the owner.
  reason      String?
  refreshedAt DateTime         @default(now())

  @@unique([boxId, productId])
  @@index([slotId])
}

/// A box the shopper built, kept apart from the basket's product lines.
model CartBox {
  id        String        @id @default(cuid())
  cartId    String
  cart      Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  boxId     String
  box       Box           @relation(fields: [boxId], references: [id], onDelete: Cascade)
  items     CartBoxItem[]
  createdAt DateTime      @default(now())

  @@index([cartId])
}

model CartBoxItem {
  id        String  @id @default(cuid())
  cartBoxId String
  cartBox   CartBox @relation(fields: [cartBoxId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)

  @@index([cartBoxId])
}

// ---------------------------------------------------------------------------
// Referrals: capped, paid only once a friend's first order is delivered and
// past the return window (src/lib/referrals.ts).
// ---------------------------------------------------------------------------

enum ReferralStatus {
  /// A new customer signed up through a link or code.
  ATTRIBUTED
  /// Their first order is placed.
  QUALIFYING
  /// Delivered; waiting out the return window (or a person's review if flagged).
  HELD
  REWARDED
  VOID
  EXPIRED
}

enum WalletEntryKind {
  REFERRAL_CREDIT
  ORDER_REDEMPTION
  REDEMPTION_REFUND
  ADJUSTMENT
}

/// The programme's rules: one row ("default"), set by the owner.
model ReferralProgram {
  id                      String   @id @default("default")
  isActive                Boolean  @default(false)
  referrerReward          Decimal  @default(100) @db.Decimal(10, 2)
  refereeReward           Decimal  @default(100) @db.Decimal(10, 2)
  /// Both the friend's welcome discount and spending credit need this order
  /// value, counted after kit, box and sale discounts.
  minOrderValue           Decimal  @default(799) @db.Decimal(10, 2)
  maxCreditPerOrder       Decimal  @default(100) @db.Decimal(10, 2)
  maxRewardsPerReferrer   Int      @default(5)
  holdDays                Int      @default(7)
  attributionDays         Int      @default(30)
  creditExpiryDays        Int      @default(180)
  /// When a code has paid its last reward: does the friend still get their discount?
  refereeDiscountAfterCap Boolean  @default(false)
  /// Referrals scoring at or above this wait for a person's review.
  riskThreshold           Int      @default(50)
  /// Rewards wait for review once a calendar month's credits would pass this.
  monthlyBudget           Decimal? @db.Decimal(10, 2)
  updatedAt               DateTime @updatedAt
}

model Referral {
  id                String          @id @default(cuid())
  codeId            String
  code              ReferralCode    @relation(fields: [codeId], references: [id])
  referrerId        String
  referrer          Customer        @relation("Referrer", fields: [referrerId], references: [id])
  /// A customer can be referred once.
  refereeId         String          @unique
  referee           Customer        @relation("Referee", fields: [refereeId], references: [id])
  status            ReferralStatus  @default(ATTRIBUTED)
  /// "LINK" (the shared link) or "CODE" (typed in).
  via               String
  qualifyingOrderId String?         @unique
  holdUntil         DateTime?
  riskScore         Int             @default(0)
  riskSignals       Json?
  /// Waiting for a person: risky, or over the monthly budget.
  flagged           Boolean         @default(false)
  voidReason        String?
  events            ReferralEvent[]
  attributedAt      DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([referrerId, attributedAt])
  @@index([status, holdUntil])
}

/// Append-only history of a referral's stages.
model ReferralEvent {
  id         String   @id @default(cuid())
  referralId String
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  /// "SYSTEM", or the admin's email.
  actor      String
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([referralId, createdAt])
}

/// Money a customer holds, as an append-only ledger (src/lib/wallet.ts works
/// out the balance). A redemption records which credits it used, so a refund
/// puts back exactly those and each credit keeps its own expiry.
model WalletEntry {
  id          String          @id @default(cuid())
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id])
  /// Rupees, signed: credits positive, redemptions negative.
  amount      Decimal         @db.Decimal(10, 2)
  kind        WalletEntryKind
  referralId  String?
  orderId     String?
  /// Credits only.
  expiresAt   DateTime?
  /// Redemptions and refunds: [{ creditId, paise }].
  allocations Json?
  note        String?
  createdAt   DateTime        @default(now())

  @@unique([kind, referralId])
  @@unique([kind, orderId])
  @@index([customerId, createdAt])
}

/// What a brand's own domain does (src/lib/brand-domains.ts).
enum BrandDomainMode {
  /// Not in use: the brand lives at sooulone.in/<brand> only.
  OFF
  /// Every visit is sent on to the brand's page on the main site.
  REDIRECT
  /// The domain is the brand's own site, on the same catalogue, basket and
  /// checkout. Its pages name the brand domain as the canonical copy.
  STANDALONE
}

/// The storefront's top bar, one message per row, in sortOrder. Text may use
/// {freeDelivery}, {area}, {deliveryFee} (src/lib/site-content.ts), filled in
/// from the live settings so the bar can't disagree with checkout.
model Announcement {
  id        String   @id @default(cuid())
  text      String
  /// Optional link, a path on this site ("/policies/shipping").
  href      String?
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// Storefront words the owner can change (Settings → Site text). Each key has
/// a default in src/lib/site-content.ts; a row here overrides it, and an empty
/// value hides that line.
model SiteText {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// A question on /help. Topic is one of FAQ_TOPICS (src/lib/site-content.ts).
/// The storefront assistant answers from published entries too.
model FaqEntry {
  id        String   @id @default(cuid())
  question  String
  /// Plain text; may use the same {tokens} as the top bar.
  answer    String
  topic     String
  /// Only about this brand; null: everyone.
  brandId   String?
  brand     Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  sortOrder Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, topic])
}

/// A /learn article. Body is the small Markdown subset in src/lib/mini-markdown.ts.
model Article {
  id                   String    @id @default(cuid())
  slug                 String    @unique
  title                String
  excerpt              String
  body                 String
  /// A content pillar (ARTICLE_PILLARS in src/lib/site-content.ts).
  pillar               String
  brandId              String?
  brand                Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  coverImageUrl        String?
  products             Product[]
  published            Boolean   @default(false)
  publishedAt          DateTime?
  /// Supplement-brand articles pass the same claims check as product copy
  /// (src/lib/compliance/claims.ts) and need a person's sign-off, cleared
  /// whenever the body changes.
  complianceReviewedAt DateTime?
  complianceReviewedBy String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([published, publishedAt])
}

enum EnquiryKind {
  COLLABORATION
  INTERNATIONAL
  GENERAL
}

enum EnquiryStatus {
  NEW
  HANDLED
}

/// A message from the /contact forms. Personal data: owner and manager only,
/// kept for ENQUIRY_RETENTION_DAYS.
model Enquiry {
  id           String        @id @default(cuid())
  kind         EnquiryKind
  name         String
  email        String
  phone        String?
  organisation String?
  country      String?
  message      String
  status       EnquiryStatus @default(NEW)
  handledBy    String?
  handledAt    DateTime?
  createdAt    DateTime      @default(now())

  @@index([status, createdAt])
}

/// An open role on /careers. None published: the careers block is hidden.
model JobOpening {
  id             String   @id @default(cuid())
  title          String
  team           String?
  location       String
  employmentType String
  summary        String
  /// Where to apply: a link, or an email address (one of the two).
  applyUrl       String?
  applyEmail     String?
  published      Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// One message to send, kept until it's sent or given up on (benchmark gap
/// M11, src/server/messages.ts). Written in the same step as what causes it,
/// then sent by a worker that retries with backoff, so a provider blip delays
/// a message instead of losing it. Holds ids, not content: the message is
/// rendered when it's sent, from the record as it is then.
model OutboundMessage {
  id          String         @id @default(cuid())
  channel     MessageChannel @default(EMAIL)
  /// What to send: a kind in src/lib/messages.ts.
  kind        String
  /// One message per key ("order_confirmation:<orderId>"), so code that runs twice can't send twice.
  dedupeKey   String         @unique
  /// What the sender needs to look up, e.g. { "enquiryId": "..." }. Never message text or contact details.
  payload     Json           @default("{}")
  orderId     String?
  order       Order?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      MessageStatus  @default(PENDING)
  attempts    Int            @default(0)
  /// Not before this time: the first send, or the next retry.
  sendAfter   DateTime       @default(now())
  /// A worker holds the message until then; a crashed worker's hold runs out and another picks it up.
  lockedUntil DateTime?
  /// The last failure, as the provider gave it (no message content).
  lastError   String?
  sentAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, sendAfter])
  @@index([orderId])
  @@index([createdAt])
}

enum MessageChannel {
  EMAIL
  WHATSAPP
  SMS
}

enum MessageStatus {
  /// Waiting to be sent (first try or a retry).
  PENDING
  /// A worker has it now.
  SENDING
  SENT
  /// Nothing to send to, or sending isn't set up: not retried.
  SKIPPED
  /// Every attempt failed. Can be retried from the console.
  FAILED
  /// Stopped from the console before it went.
  CANCELLED
}

/// A firm SooulOne buys from or whose products it sells: manufacturers,
/// packers, marketers and distributors, each with its FSSAI licence. FSSAI
/// licence conditions require buying only from licensed vendors and keeping
/// the record (Annexure 3, condition 14). Managed under Suppliers; the owner
/// is emailed before a licence expires (src/server/suppliers.ts).
model Supplier {
  id               String            @id @default(cuid())
  name             String
  address          String
  /// The 14-digit FSSAI licence or registration number.
  fssaiLicence     String?
  licenceType      FssaiLicenceType?
  licenceExpiresOn DateTime?
  gstin            String?
  contactName      String?
  contactPhone     String?
  contactEmail     String?
  notes            String?
  /// No longer bought from; kept for the records of past batches.
  isActive         Boolean           @default(true)
  manufactured     Product[]         @relation("ProductManufacturer")
  marketed         Product[]         @relation("ProductMarketer")
  batches          ProductBatch[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([licenceExpiresOn])
}

enum FssaiLicenceType {
  /// Central licence (FSSAI): required for e-commerce, importers and large operators.
  CENTRAL
  /// State licence.
  STATE
  /// Basic registration, for small businesses.
  REGISTRATION
}

/// The check of one line of a parcel that came back (RTO, or returned by the
/// customer): back on sale, set aside to decide later, or written off. Only
/// "back to stock" adds the units to the batch again (src/lib/returns.ts).
model ReturnCheck {
  id          String        @id @default(cuid())
  orderItemId String        @unique
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  outcome     ReturnOutcome
  quantity    Int
  note        String?
  decidedBy   String
  decidedAt   DateTime      @default(now())

  @@index([outcome])
}

enum ReturnOutcome {
  /// Sealed and fit to sell: the units go back into the batch.
  RESTOCKED
  /// Kept aside until someone decides (a damaged outer carton, a query to the supplier).
  QUARANTINED
  /// Opened, damaged, recalled or too close to expiry: not sold again.
  WRITTEN_OFF
}

/// A shopper's named Make Your Own Box (benchmark gap R4), to put in the
/// basket again in one tap. The picks are checked against the box's rules and
/// live stock each time, like any box (src/server/boxes.ts).
model SavedBox {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  boxId      String
  box        Box      @relation(fields: [boxId], references: [id], onDelete: Cascade)
  name       String
  /// [{ productId, quantity }]
  picks      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

/// "Email me when it's back" on a sold-out product (benchmark gap R9). One
/// email, once the product can be shipped again, then done. The request is
/// also kept as a consent record (purpose BACK_IN_STOCK).
model StockAlert {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  email      String
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  /// When the email was queued; null while still waiting.
  notifiedAt DateTime?

  @@unique([productId, email])
  @@index([notifiedAt, productId])
}
