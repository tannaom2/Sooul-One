# =============================================================================
# SooulOne — environment variables (build prompt Section 13)
# Copy to .env.local for development. Never commit a filled-in copy.
# =============================================================================

# --- Database ---------------------------------------------------------------
# Neon/Supabase free tier recommended over Render Postgres (Section 10):
# permanent rather than 30-day, pooled, and $0.
DATABASE_URL="postgresql://user:password@host:5432/soulone?sslmode=require"
# The same database's DIRECT (unpooled) connection, used only for migrations.
# On Neon it's the connection string with pooling switched off (no "-pooler"
# in the host). Leave blank locally to fall back to DATABASE_URL.
DIRECT_URL=""

# --- Admin console auth (isolated from customer auth by design) -------------
# Generate with: openssl rand -base64 32
JWT_SECRET=""

# --- Customer auth (Auth.js) ------------------------------------------------
# The site's own public URL — used for the sitemap, robots.txt and metadata
# (canonical/OG URLs). Not an auth setting despite the historical name of the
# variable it replaces; NEXTAUTH_SECRET and next-auth itself were removed as
# unused (the real session secret is JWT_SECRET above).
SITE_URL="http://localhost:3000"

# --- Payments ---------------------------------------------------------------
# Hosted Checkout only. Card data never touches this application, which is what
# keeps PCI-DSS scope at SAQ-A (Section 8.1).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# The webhook is the source of truth for order status, not the browser redirect.
RAZORPAY_WEBHOOK_SECRET=""

# --- Media & email ----------------------------------------------------------
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
RESEND_API_KEY=""
# Sender for order emails. Must be a domain you have verified with Resend.
EMAIL_FROM="SooulOne <orders@yourdomain.in>"
# Where near-expiry stock alerts go. Leave blank to disable them.
OWNER_ALERT_EMAIL=""
# Shared secret the near-expiry cron job must present to trigger the alert.
# Generate any random string; the scheduler passes it back as ?secret= or the
# x-cron-secret header. Leave blank and the endpoint refuses to run.
CRON_SECRET=""

# --- Monitoring -------------------------------------------------------------
SENTRY_DSN=""

# --- Tax ---------------------------------------------------------------------
# The state SooulOne is GST-registered in. Decides whether an order is charged
# CGST+SGST (same state) or IGST (different state).
SELLER_STATE="Gujarat"

# --- Launch gate --------------------------------------------------------------
# On the public site (an https SITE_URL), checkout stays closed until every
# required item on Admin → Launch checklist is done. "off" is an emergency
# override only; leave it unset.
# LAUNCH_GATE="off"

# --- Runtime ----------------------------------------------------------------
NODE_ENV="development"

# --- Compliance display -----------------------------------------------------
# 14-digit FSSAI licence number. Rendered site-wide in the footer and on every
# product listing. Leave blank until the licence is issued — the footer shows a
# non-compliant state rather than a fabricated number (Section 14).
NEXT_PUBLIC_FSSAI_LICENCE_NUMBER=""
NEXT_PUBLIC_GSTIN=""
